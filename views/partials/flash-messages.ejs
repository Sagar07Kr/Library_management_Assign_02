<div id="toast-container" class="toast-container" aria-live="polite" aria-atomic="true">
  <% if (typeof success !== 'undefined' && success && success.length > 0) { %>
    <% success.forEach(msg => { %>
      <div class="toast toast-success" role="alert">
        <div class="toast-icon-wrap" aria-hidden="true">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
          </svg>
        </div>
        <div class="toast-content">
          <p class="toast-message"><%= msg %></p>
        </div>
        <button type="button" class="toast-close-btn" aria-label="Dismiss notification">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    <% }) %>
  <% } %>

  <% if (typeof error !== 'undefined' && error && error.length > 0) { %>
    <% error.forEach(msg => { %>
      <div class="toast toast-error" role="alert">
        <div class="toast-icon-wrap" aria-hidden="true">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </div>
        <div class="toast-content">
          <p class="toast-message"><%= msg %></p>
        </div>
        <button type="button" class="toast-close-btn" aria-label="Dismiss notification">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    <% }) %>
  <% } %>

  <% if (typeof warning !== 'undefined' && warning && warning.length > 0) { %>
    <% warning.forEach(msg => { %>
      <div class="toast toast-warning" role="alert">
        <div class="toast-icon-wrap" aria-hidden="true">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
          </svg>
        </div>
        <div class="toast-content">
          <p class="toast-message"><%= msg %></p>
        </div>
        <button type="button" class="toast-close-btn" aria-label="Dismiss notification">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    <% }) %>
  <% } %>

  <% if (typeof info !== 'undefined' && info && info.length > 0) { %>
    <% info.forEach(msg => { %>
      <div class="toast toast-info" role="alert">
        <div class="toast-icon-wrap" aria-hidden="true">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        </div>
        <div class="toast-content">
          <p class="toast-message"><%= msg %></p>
        </div>
        <button type="button" class="toast-close-btn" aria-label="Dismiss notification">
          <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
    <% }) %>
  <% } %>
</div>
