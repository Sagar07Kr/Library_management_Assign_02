<%
  const coverUrl = book.coverImage || (typeof h !== 'undefined' && h.getPlaceholderCover ? h.getPlaceholderCover(book.title) : 'https://placehold.co/300x400/4f46e5/ffffff?text=' + encodeURIComponent(book.title.slice(0, 10)));
  const isAvailable = book.availableCopies > 0;
  const isLowStock = isAvailable && book.availableCopies <= 2;
%>
<article class="book-card card-hover" id="book-card-<%= book._id %>">
  <!-- Cover image container -->
  <div class="book-cover-container">
    <img
      src="<%= coverUrl %>"
      alt="Cover of <%= book.title %>"
      class="book-cover-img"
      loading="lazy"
      onerror="this.onerror=null; this.src='https://placehold.co/300x400/4f46e5/ffffff?text=Book';"
    >

    <!-- Badge overlay -->
    <div class="book-badge-overlay">
      <% if (!isAvailable) { %>
        <span class="badge badge-danger">
          <span class="badge-dot"></span> Out of Stock
        </span>
      <% } else if (isLowStock) { %>
        <span class="badge badge-warning">
          <span class="badge-dot"></span> Only <%= book.availableCopies %> left
        </span>
      <% } else { %>
        <span class="badge badge-success">
          <span class="badge-dot"></span> Available
        </span>
      <% } %>
    </div>

    <!-- Quick action hover overlay -->
    <div class="book-card-actions">
      <a href="/books/<%= book._id %>" class="btn btn-secondary btn-sm" aria-label="View details of <%= book.title %>">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span>View Details</span>
      </a>
      <% if (isAvailable) { %>
        <a href="/books/<%= book._id %>#borrow-form" class="btn btn-primary btn-sm">
          <span>Borrow</span>
        </a>
      <% } %>
    </div>
  </div>

  <!-- Book information -->
  <div class="book-card-info">
    <span class="book-category"><%= book.category %></span>
    <h3 class="book-title" title="<%= book.title %>">
      <a href="/books/<%= book._id %>"><%= book.title %></a>
    </h3>
    <p class="book-author">by <%= book.author %></p>

    <!-- Rating stars mock for high polish SaaS aesthetic -->
    <div style="display: flex; align-items: center; gap: 4px; margin-bottom: var(--space-3);">
      <div style="display: flex; color: #F59E0B;" aria-label="Rating: 4.8 out of 5 stars">
        <% for(let s=0; s<5; s++) { %>
          <svg width="14" height="14" fill="currentColor" viewBox="0 0 20 20">
            <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
          </svg>
        <% } %>
      </div>
      <span style="font-size: var(--text-xs); color: var(--text-muted); font-weight: 500;">4.8</span>
    </div>

    <div class="book-card-footer">
      <span>ISBN: <%= book.isbn %></span>
      <span><%= book.publicationYear || '' %></span>
    </div>
  </div>
</article>
