<header class="navbar" role="banner">
  <div class="container navbar-inner">
    <!-- Brand / Logo -->
    <a href="/" class="navbar-brand" aria-label="LibraryMS Home">
      <div class="brand-icon-wrapper" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <span>Library<span style="color: var(--primary);">MS</span></span>
    </a>

    <!-- Desktop Navigation Links -->
    <nav class="navbar-nav" aria-label="Main Navigation">
      <a href="/books" class="nav-link <%= typeof title !== 'undefined' && title.includes('Catalogue') ? 'active' : '' %>">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
      </svg>
        <span>Catalogue</span>
      </a>

      <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a href="/admin" class="nav-link <%= typeof title !== 'undefined' && title.includes('Admin') ? 'active' : '' %>">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
            </svg>
            <span>Console</span>
          </a>
          <a href="/admin/requests" class="nav-link <%= typeof title !== 'undefined' && title.includes('Request') ? 'active' : '' %>">
            <span>Requests</span>
          </a>
          <a href="/admin/books" class="nav-link">Books</a>
          <a href="/admin/members" class="nav-link">Members</a>
          <a href="/admin/loans" class="nav-link">Circulation</a>
        <% } else { %>
          <a href="/dashboard" class="nav-link <%= typeof title !== 'undefined' && title.includes('Dashboard') ? 'active' : '' %>">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
            </svg>
            <span>Dashboard</span>
          </a>
          <a href="/my-loans" class="nav-link <%= typeof title !== 'undefined' && title.includes('Loans') ? 'active' : '' %>">
            <span>My Borrowed Books</span>
          </a>
          <a href="/history" class="nav-link <%= typeof title !== 'undefined' && title.includes('History') ? 'active' : '' %>">
            <span>History</span>
          </a>
        <% } %>
      <% } %>
    </nav>

    <!-- Search Input -->
    <form action="/books" method="GET" class="navbar-search" role="search">
      <svg class="search-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input type="search" name="q" placeholder="Search title, author, ISBN..." aria-label="Search catalog" value="<%= typeof query !== 'undefined' && query.q ? query.q : '' %>">
    </form>

    <!-- Actions (Theme Toggle + Auth / Profile) -->
    <div class="navbar-actions">
      <!-- Dark Mode Toggle Button -->
      <button type="button" class="theme-toggle-btn" id="theme-toggle-btn" aria-label="Toggle theme">
        <!-- Sun icon (for dark mode) -->
        <svg class="sun-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" />
        </svg>
        <!-- Moon icon (for light mode) -->
        <svg class="moon-icon" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" />
        </svg>
      </button>

      <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated && currentUser) { %>
        <!-- User Avatar & Dropdown -->
        <div class="user-menu-wrapper" id="user-menu-wrapper">
          <button type="button" class="user-menu-btn" id="user-menu-btn" aria-haspopup="true" aria-expanded="false" aria-label="User menu">
            <div class="user-avatar" aria-hidden="true">
              <%= currentUser.fullName ? currentUser.fullName.split(' ').filter(Boolean).map(n=>n[0]).join('').slice(0,2).toUpperCase() : 'U' %>
            </div>
            <span class="user-menu-name"><%= currentUser.fullName ? currentUser.fullName.split(' ')[0] : 'Account' %></span>
            <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
            </svg>
          </button>

          <!-- Dropdown items -->
          <div class="user-dropdown" id="user-dropdown" role="menu" aria-label="User navigation">
            <div class="user-dropdown-header">
              <div class="user-name"><%= currentUser.fullName %></div>
              <div class="user-email"><%= currentUser.email %></div>
            </div>

            <% if (currentUser.role === 'ADMIN') { %>
              <a href="/admin" class="user-dropdown-item" role="menuitem">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
                <span>Admin Console</span>
              </a>
            <% } else { %>
              <a href="/dashboard" class="user-dropdown-item" role="menuitem">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" /></svg>
                <span>Dashboard</span>
              </a>
              <a href="/my-loans" class="user-dropdown-item" role="menuitem">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" /></svg>
                <span>My Books</span>
              </a>
            <% } %>

            <a href="/profile" class="user-dropdown-item" role="menuitem">
              <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" /></svg>
              <span>Profile Settings</span>
            </a>

            <form action="/logout" method="POST" style="margin: 0;">
              <button type="submit" class="user-dropdown-item danger" role="menuitem">
                <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 16l4-4m0 0l-4-4m4 4H7m6 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h4a3 3 0 013 3v1" /></svg>
                <span>Sign Out</span>
              </button>
            </form>
          </div>
        </div>
      <% } else { %>
        <!-- Guest CTA Buttons -->
        <a href="/login" class="btn btn-ghost btn-sm">Sign In</a>
        <a href="/register" class="btn btn-primary btn-sm">Get Started</a>
      <% } %>

      <!-- Mobile Hamburger Button -->
      <button type="button" class="menu-toggle-btn" id="menu-toggle-btn" aria-label="Open navigation menu">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer Backdrop -->
<div class="mobile-drawer-backdrop" id="mobile-drawer-backdrop" aria-hidden="true"></div>

<!-- Mobile Navigation Drawer -->
<aside class="mobile-drawer" id="mobile-drawer" aria-label="Mobile Navigation">
  <div class="mobile-drawer-header">
    <div class="navbar-brand">
      <div class="brand-icon-wrapper" style="width: 32px; height: 32px;">
        <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <span>LibraryMS</span>
    </div>
    <button type="button" class="mobile-drawer-close" id="mobile-drawer-close" aria-label="Close navigation">
      <svg width="24" height="24" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <ul class="mobile-drawer-nav">
    <li><a href="/books" class="mobile-nav-link">Catalogue</a></li>
    <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
      <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
        <li><a href="/admin" class="mobile-nav-link">Admin Console</a></li>
        <li><a href="/admin/requests" class="mobile-nav-link">Borrow Requests Queue</a></li>
        <li><a href="/admin/books" class="mobile-nav-link">Books Management</a></li>
        <li><a href="/admin/members" class="mobile-nav-link">Members</a></li>
        <li><a href="/admin/loans" class="mobile-nav-link">Circulation & Returns</a></li>
      <% } else { %>
        <li><a href="/dashboard" class="mobile-nav-link">Dashboard</a></li>
        <li><a href="/my-loans" class="mobile-nav-link">My Borrowed Books</a></li>
        <li><a href="/history" class="mobile-nav-link">History</a></li>
        <li><a href="/profile" class="mobile-nav-link">Profile Settings</a></li>
      <% } %>
      <li style="margin-top: var(--space-4); border-top: 1px solid var(--border); padding-top: var(--space-4);">
        <form action="/logout" method="POST">
          <button type="submit" class="btn btn-outline btn-block" style="color: var(--danger); border-color: var(--danger);">Sign Out</button>
        </form>
      </li>
    <% } else { %>
      <li style="margin-top: var(--space-4); display: flex; flex-direction: column; gap: var(--space-2);">
        <a href="/login" class="btn btn-secondary btn-block">Sign In</a>
        <a href="/register" class="btn btn-primary btn-block">Create Account</a>
      </li>
    <% } %>
  </ul>
</aside>
