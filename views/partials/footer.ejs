<footer class="footer" role="contentinfo">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Brand & Bio -->
      <div class="footer-brand">
        <a href="/" class="navbar-brand">
          <div class="brand-icon-wrapper" style="width: 32px; height: 32px;">
            <svg style="width: 18px; height: 18px;" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <span>Library<span style="color: var(--primary);">MS</span></span>
        </a>
        <p class="footer-desc">
          Next-generation digital library intelligence. Streamlined book cataloging, seamless member lending, automated due dates, and real-time analytics.
        </p>
      </div>

      <!-- Col 2: Discover -->
      <div>
        <h4 class="footer-col-title">Discover</h4>
        <ul class="footer-links">
          <li><a href="/books">Explore Catalogue</a></li>
          <li><a href="/books?category=Programming">Programming & Tech</a></li>
          <li><a href="/books?category=Science">Science & Math</a></li>
          <li><a href="/books?category=Fiction">Classic Fiction</a></li>
        </ul>
      </div>

      <!-- Col 3: Portal -->
      <div>
        <h4 class="footer-col-title">Portal</h4>
        <ul class="footer-links">
          <% if (typeof isAuthenticated !== 'undefined' && isAuthenticated) { %>
            <li><a href="/dashboard">Member Dashboard</a></li>
            <li><a href="/my-loans">Active Loans</a></li>
            <li><a href="/profile">Account Settings</a></li>
          <% } else { %>
            <li><a href="/login">Member Login</a></li>
            <li><a href="/register">Register Membership</a></li>
            <li><a href="/login">Admin Access</a></li>
          <% } %>
        </ul>
      </div>

      <!-- Col 4: Platform -->
      <div>
        <h4 class="footer-col-title">Platform</h4>
        <ul class="footer-links">
          <li><a href="/#about">About Platform</a></li>
          <li><a href="/#features">Key Features</a></li>
          <li><a href="/#faq">Library Rules & Fines</a></li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p>© <%= new Date().getFullYear() %> LibraryMS. Engineered for high performance & modern accessibility.</p>
      <div style="display: flex; gap: var(--space-4);">
        <span>Built with Node.js & MongoDB</span>
        <span>•</span>
        <span>Strict WCAG AA Standards</span>
      </div>
    </div>
  </div>
</footer>
