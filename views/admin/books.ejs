<div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16);">
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/admin">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg>
      <span>Admin Console</span>
    </a>
    <span class="separator" aria-hidden="true">/</span>
    <span class="current" aria-current="page">Book Management</span>
  </nav>

  <!-- Page Header with Action -->
  <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4); margin-bottom: var(--space-6);">
    <div>
      <h1 style="font-size: var(--text-3xl); font-weight: 800; letter-spacing: -0.03em;">Book Management</h1>
      <p style="color: var(--text-muted); font-size: var(--text-base);">
        Maintain catalogue inventory, update descriptions, and track copy availability (<%= pagination.total %> total).
      </p>
    </div>
    <a href="/admin/books/create" class="btn btn-primary btn-md" id="add-book-btn">
      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
      </svg>
      <span>Add New Book</span>
    </a>
  </div>

  <!-- Search & Filters Toolbar -->
  <form action="/admin/books" method="GET" class="card" style="padding: var(--space-4); margin-bottom: var(--space-6);">
    <div style="display: grid; grid-template-columns: 1fr; gap: var(--space-3);" class="filters-grid">
      <div style="display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center;">
        <!-- Search -->
        <div class="input-wrapper" style="flex: 1; min-width: 200px;">
          <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="search"
            name="search"
            class="form-control has-icon-left"
            placeholder="Search by title or author..."
            value="<%= filters.search || '' %>"
          >
        </div>

        <!-- Category Filter -->
        <div style="min-width: 160px;">
          <select name="category" class="form-control">
            <option value="all">All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <!-- Status Filter -->
        <div style="min-width: 140px;">
          <select name="status" class="form-control">
            <option value="">All Status</option>
            <option value="active" <%= filters.status === 'active' ? 'selected' : '' %>>Active</option>
            <option value="inactive" <%= filters.status === 'inactive' ? 'selected' : '' %>>Inactive / Archived</option>
          </select>
        </div>

        <!-- Action Buttons -->
        <div style="display: flex; gap: var(--space-2);">
          <button type="submit" class="btn btn-primary btn-md">Filter</button>
          <a href="/admin/books" class="btn btn-ghost btn-md">Reset</a>
        </div>
      </div>
    </div>
  </form>

  <!-- Books Data Table -->
  <% if (books.length === 0) { %>
    <div class="empty-state">
      <div class="empty-state-icon" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <h2 class="empty-state-title">No books match your criteria</h2>
      <p class="empty-state-desc">Try clearing your filters or create a new book title in the catalogue.</p>
      <a href="/admin/books/create" class="btn btn-primary btn-md">Add New Book</a>
    </div>
  <% } else { %>
    <div class="card" style="overflow: hidden;">
      <div class="table-responsive">
        <table class="table table-hover table-striped">
          <thead>
            <tr>
              <th scope="col">Book Info</th>
              <th scope="col">ISBN</th>
              <th scope="col">Category</th>
              <th scope="col">Total</th>
              <th scope="col">Available</th>
              <th scope="col">Stock Status</th>
              <th scope="col" style="text-align: right;">Actions</th>
            </tr>
          </thead>
          <tbody>
            <% books.forEach(book => { %>
              <tr id="book-row-<%= book._id %>">
                <td>
                  <div style="display: flex; align-items: center; gap: var(--space-3);">
                    <img
                      src="<%= book.coverImage || (typeof h !== 'undefined' ? h.getPlaceholderCover(book.title) : '') %>"
                      alt=""
                      style="width: 38px; height: 50px; border-radius: var(--radius-sm); object-fit: cover; border: 1px solid var(--border);"
                      loading="lazy"
                    >
                    <div style="min-width: 0;">
                      <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 220px;">
                        <%= book.title %>
                      </p>
                      <p style="font-size: var(--text-xs); color: var(--text-muted); margin: 0;"><%= book.author %></p>
                    </div>
                  </div>
                </td>
                <td style="font-size: var(--text-xs); font-family: monospace; color: var(--text);"><%= book.isbn %></td>
                <td><span class="badge badge-primary"><%= book.category %></span></td>
                <td style="font-size: var(--text-sm); font-weight: 600;"><%= book.totalCopies %></td>
                <td style="font-size: var(--text-sm); font-weight: 700; color: <%= book.availableCopies > 0 ? 'var(--success)' : 'var(--danger)' %>;">
                  <%= book.availableCopies %>
                </td>
                <td>
                  <% if (book.isActive) { %>
                    <% if (book.availableCopies === 0) { %>
                      <span class="badge badge-danger"><span class="badge-dot"></span> Out of Stock</span>
                    <% } else if (book.availableCopies <= 2) { %>
                      <span class="badge badge-warning"><span class="badge-dot"></span> Limited (<%= book.availableCopies %>)</span>
                    <% } else { %>
                      <span class="badge badge-success"><span class="badge-dot"></span> Available</span>
                    <% } %>
                  <% } else { %>
                    <span class="badge badge-secondary"><span class="badge-dot"></span> Archived</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <div class="table-actions" style="justify-content: flex-end;">
                    <!-- View Book Publicly -->
                    <a href="/books/<%= book._id %>" class="btn btn-ghost btn-icon-only" title="View details" aria-label="View <%= book.title %>">
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                      </svg>
                    </a>
                    <!-- Edit Book Form -->
                    <a href="/admin/books/<%= book._id %>/edit" class="btn btn-ghost btn-icon-only" title="Edit book" aria-label="Edit <%= book.title %>">
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
                      </svg>
                    </a>
                    <!-- Delete Confirmation -->
                    <button
                      type="button"
                      class="btn btn-ghost btn-icon-only"
                      style="color: var(--danger);"
                      title="Deactivate / Delete"
                      aria-label="Delete <%= book.title %>"
                      onclick="openDeleteModal('/admin/books/<%= book._id %>/delete', '<%= book.title.replace(/'/g, "\\'") %>')"
                    >
                      <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                      </svg>
                    </button>
                  </div>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Pagination -->
    <% if (pagination.totalPages > 1) { %>
      <%
        const paginationData = {
          page: pagination.page,
          pages: pagination.totalPages,
          hasPrev: pagination.page > 1,
          hasNext: pagination.page < pagination.totalPages,
        };
        const queryData = {
          search: filters.search || '',
          category: filters.category || '',
          status: filters.status || '',
        };
      %>
      <%- include('../partials/pagination', { pagination: paginationData, query: queryData }) %>
    <% } %>
  <% } %>
</div>
