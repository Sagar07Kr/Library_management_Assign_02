<div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16);">
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/admin">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
      </svg>
      <span>Admin</span>
    </a>
    <span class="separator" aria-hidden="true">/</span>
    <a href="/admin/members">Members</a>
    <span class="separator" aria-hidden="true">/</span>
    <span class="current" aria-current="page"><%= member.fullName %></span>
  </nav>

  <!-- Profile Hero Header -->
  <div class="card" style="padding: var(--space-6); margin-bottom: var(--space-8);">
    <div style="display: flex; align-items: center; gap: var(--space-5); flex-wrap: wrap;">
      <div class="user-avatar" style="width: 64px; height: 64px; font-size: var(--text-xl);">
        <%= member.fullName.split(' ').map(n => n[0]).join('').toUpperCase().slice(0, 2) %>
      </div>
      <div style="flex: 1; min-width: 220px;">
        <h1 style="font-size: var(--text-2xl); font-weight: 800; color: var(--text); margin-bottom: 2px;">
          <%= member.fullName %>
        </h1>
        <p style="font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--space-2);">
          <%= member.email %> • <%= member.phone || 'No phone provided' %>
        </p>
        <div style="display: flex; gap: 8px;">
          <span class="badge badge-primary"><%= member.role %></span>
          <span class="badge <%= member.isActive ? 'badge-success' : 'badge-danger' %>">
            <span class="badge-dot"></span> <%= member.isActive ? 'Active Member' : 'Deactivated' %>
          </span>
        </div>
      </div>
    </div>
  </div>

  <!-- 2 Column Details: Overview & Active Loans -->
  <div class="grid-2" style="margin-bottom: var(--space-10);">
    <!-- Overview Card -->
    <div class="card">
      <div class="card-header">
        <h2 style="font-size: var(--text-base); font-weight: 700; color: var(--text);">Member Metrics</h2>
      </div>
      <div class="card-body" style="padding: var(--space-4);">
        <div class="list-item">
          <div style="flex: 1;">
            <p class="text-xs text-muted" style="text-transform: uppercase;">Registered On</p>
            <p class="font-semibold text-sm"><%= typeof h !== 'undefined' ? h.formatDate(member.createdAt) : new Date(member.createdAt).toLocaleDateString() %></p>
          </div>
        </div>
        <div class="list-item">
          <div style="flex: 1;">
            <p class="text-xs text-muted" style="text-transform: uppercase;">Currently Borrowed</p>
            <p class="font-semibold text-sm"><%= activeLoans.length %> books</p>
          </div>
        </div>
        <div class="list-item">
          <div style="flex: 1;">
            <p class="text-xs text-muted" style="text-transform: uppercase;">Total Historical Borrows</p>
            <p class="font-semibold text-sm"><%= history.length %> checkouts</p>
          </div>
        </div>
      </div>
    </div>

    <!-- Active Loans Card -->
    <div class="card">
      <div class="card-header">
        <h2 style="font-size: var(--text-base); font-weight: 700; color: var(--text);">Active Borrowed Books</h2>
        <span class="badge badge-primary"><%= activeLoans.length %></span>
      </div>
      <div class="card-body" style="padding: 0;">
        <% if (activeLoans.length === 0) { %>
          <p style="padding: var(--space-6); text-align: center; color: var(--text-muted); font-size: var(--text-sm);">
            No active loans on this account.
          </p>
        <% } else { %>
          <% activeLoans.forEach(loan => { %>
            <div class="list-item">
              <div style="flex: 1; min-width: 0;">
                <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text); margin: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                  <%= loan.book ? loan.book.title : 'Unknown Book' %>
                </p>
                <p style="font-size: var(--text-xs); color: var(--text-muted); margin: 0;">
                  Due: <%= typeof h !== 'undefined' ? h.formatDate(loan.dueDate) : new Date(loan.dueDate).toLocaleDateString() %>
                </p>
              </div>
              <span class="badge <%= loan.status === 'OVERDUE' ? 'badge-danger' : 'badge-primary' %>">
                <span class="badge-dot"></span> <%= loan.status %>
              </span>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </div>

  <!-- Complete Borrowing History Table -->
  <section aria-label="Member history">
    <h2 style="font-size: var(--text-xl); font-weight: 800; color: var(--text); margin-bottom: var(--space-4);">
      Circulation History
    </h2>
    <% if (history.length === 0) { %>
      <div class="card" style="padding: var(--space-8); text-align: center; color: var(--text-muted);">
        <p style="font-size: var(--text-sm);">No past loan records found for this member.</p>
      </div>
    <% } else { %>
      <div class="card" style="overflow: hidden;">
        <div class="table-responsive">
          <table class="table table-hover table-striped">
            <thead>
              <tr>
                <th scope="col">Book</th>
                <th scope="col">Issued</th>
                <th scope="col">Due</th>
                <th scope="col">Returned</th>
                <th scope="col">Status</th>
                <th scope="col">Fine</th>
              </tr>
            </thead>
            <tbody>
              <% history.forEach(loan => { %>
                <tr>
                  <td style="font-weight: 600; color: var(--text);">
                    <%= loan.book ? loan.book.title : 'Archived Book' %>
                  </td>
                  <td style="font-size: var(--text-xs);"><%= typeof h !== 'undefined' ? h.formatDate(loan.issuedAt) : new Date(loan.issuedAt).toLocaleDateString() %></td>
                  <td style="font-size: var(--text-xs);"><%= typeof h !== 'undefined' ? h.formatDate(loan.dueDate) : new Date(loan.dueDate).toLocaleDateString() %></td>
                  <td style="font-size: var(--text-xs);">
                    <%= loan.returnedAt ? (typeof h !== 'undefined' ? h.formatDate(loan.returnedAt) : new Date(loan.returnedAt).toLocaleDateString()) : '—' %>
                  </td>
                  <td>
                    <span class="badge <%= loan.status === 'RETURNED' ? 'badge-success' : (loan.status === 'OVERDUE' ? 'badge-danger' : 'badge-primary') %>">
                      <span class="badge-dot"></span> <%= loan.status %>
                    </span>
                  </td>
                  <td style="font-size: var(--text-sm); font-weight: 600; color: <%= loan.fineAmount > 0 ? 'var(--danger)' : 'var(--text-muted)' %>;">
                    <%= loan.fineAmount > 0 ? '₹' + loan.fineAmount : '—' %>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    <% } %>
  </section>
</div>
