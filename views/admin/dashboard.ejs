<div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16);">
  <!-- Header with Quick Action -->
  <div style="display: flex; flex-direction: column; gap: var(--space-4); margin-bottom: var(--space-8);">
    <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: var(--space-4);">
      <div>
        <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; background: var(--primary-soft); border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 700; color: var(--primary); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-2);">
          <span>Admin Command Center</span>
        </div>
        <h1 style="font-size: var(--text-3xl); font-weight: 800; letter-spacing: -0.03em;">Library Analytics & Control</h1>
        <p style="color: var(--text-muted); font-size: var(--text-base);">Real-time inventory levels, circulation metrics, and user activity.</p>
      </div>

      <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
        <a href="/admin/books/create" class="btn btn-primary btn-md" id="admin-add-book-btn">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
          </svg>
          <span>Add New Book</span>
        </a>
        <a href="/admin/loans" class="btn btn-secondary btn-md">
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
          </svg>
          <span>Loan Records</span>
        </a>
      </div>
    </div>
  </div>

  <!-- KPI Metrics Grid -->
  <section class="stats-grid" aria-label="Key Performance Indicators">
    <!-- Stat: Pending Requests (Librarian Queue) -->
    <div class="stat-card" style="<%= (stats.pendingRequests || 0) > 0 ? 'border-color: var(--warning);' : '' %>">
      <div class="stat-icon warning" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
        </svg>
      </div>
      <div>
        <div style="display: flex; justify-content: space-between; align-items: baseline;">
          <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Pending Requests</p>
        </div>
        <p class="stat-value" style="<%= (stats.pendingRequests || 0) > 0 ? 'color: var(--warning);' : '' %>">
          <a href="/admin/requests" style="color: inherit; text-decoration: none;"><%= stats.pendingRequests || 0 %></a>
        </p>
      </div>
    </div>

    <!-- Stat: Active Loans -->
    <div class="stat-card">
      <div class="stat-icon primary" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Active Loans</p>
        <p class="stat-value"><%= stats.issuedBooks %></p>
      </div>
    </div>

    <!-- Stat: Overdue Loans -->
    <div class="stat-card">
      <div class="stat-icon danger" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Overdue</p>
        <p class="stat-value" style="<%= stats.overdueBooks > 0 ? 'color: var(--danger);' : '' %>"><%= stats.overdueBooks %></p>
      </div>
    </div>

    <!-- Stat: Returned Today -->
    <div class="stat-card">
      <div class="stat-icon success" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Returned Today</p>
        <p class="stat-value" style="color: var(--success);"><%= stats.returnedToday || 0 %></p>
      </div>
    </div>

    <!-- Stat: Total Titles -->
    <div class="stat-card">
      <div class="stat-icon primary" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Total Titles</p>
        <p class="stat-value"><%= stats.totalBooks %></p>
      </div>
    </div>

    <!-- Stat: Available Stock -->
    <div class="stat-card">
      <div class="stat-icon info" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Available Copies</p>
        <p class="stat-value"><%= stats.availableCopies %> / <%= stats.totalCopies %></p>
      </div>
    </div>

    <!-- Stat: Registered Members -->
    <div class="stat-card">
      <div class="stat-icon info" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Active Members</p>
        <p class="stat-value"><%= stats.totalMembers %></p>
      </div>
    </div>

    <!-- Stat: Outstanding Fines -->
    <div class="stat-card">
      <div class="stat-icon warning" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Unpaid Fines</p>
        <p class="stat-value" style="<%= stats.outstandingFines > 0 ? 'color: var(--warning);' : '' %>">
          <%= typeof h !== 'undefined' ? h.formatCurrency(stats.outstandingFines) : '₹' + stats.outstandingFines %>
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Charts Grid (Chart.js) -->
  <section class="grid-2" style="margin-bottom: var(--space-8);" aria-label="Visual Analytics">
    <!-- Category Distribution Chart -->
    <div class="card">
      <div class="card-header">
        <h2 style="font-size: var(--text-base); font-weight: 700; color: var(--text);">Catalogue by Category</h2>
        <span class="badge badge-secondary">Inventory Split</span>
      </div>
      <div class="card-body">
        <div class="chart-container" style="height: 280px;">
          <canvas id="category-chart" data-chart='<%- JSON.stringify(categoryDist) %>'></canvas>
        </div>
      </div>
    </div>

    <!-- Monthly Borrowing Activity Chart -->
    <div class="card">
      <div class="card-header">
        <h2 style="font-size: var(--text-base); font-weight: 700; color: var(--text);">Borrowing Trends</h2>
        <span class="badge badge-secondary">Monthly Velocity</span>
      </div>
      <div class="card-body">
        <div class="chart-container" style="height: 280px;">
          <canvas id="monthly-chart" data-chart='<%- JSON.stringify(monthlyActivity) %>'></canvas>
        </div>
      </div>
    </div>
  </section>

  <!-- Most Borrowed Titles & Most Active Readers -->
  <section class="grid-2" style="margin-bottom: var(--space-8);" aria-label="Ranking Feeds">
    <!-- Most Borrowed Books -->
    <div class="card">
      <div class="card-header">
        <h2 style="font-size: var(--text-base); font-weight: 700; color: var(--text);">Most Borrowed Titles</h2>
      </div>
      <div class="card-body" style="padding: 0;">
        <% if (mostBorrowed.length === 0) { %>
          <p style="padding: var(--space-6); text-align: center; color: var(--text-muted); font-size: var(--text-sm);">No circulation records recorded yet.</p>
        <% } else { %>
          <% mostBorrowed.forEach((book, i) => { %>
            <div class="list-item">
              <span class="list-rank"><%= i + 1 %></span>
              <div style="flex: 1; min-width: 0;">
                <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0;">
                  <%= book.title %>
                </p>
                <p style="font-size: var(--text-xs); color: var(--text-muted); margin: 0;"><%= book.author %></p>
              </div>
              <span class="badge badge-primary"><%= book.totalLoans %> loans</span>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>

    <!-- Most Active Members -->
    <div class="card">
      <div class="card-header">
        <h2 style="font-size: var(--text-base); font-weight: 700; color: var(--text);">Most Active Members</h2>
      </div>
      <div class="card-body" style="padding: 0;">
        <% if (mostActive.length === 0) { %>
          <p style="padding: var(--space-6); text-align: center; color: var(--text-muted); font-size: var(--text-sm);">No active members with loans yet.</p>
        <% } else { %>
          <% mostActive.forEach((member, i) => { %>
            <div class="list-item">
              <span class="list-rank"><%= i + 1 %></span>
              <div style="flex: 1; min-width: 0;">
                <p style="font-size: var(--text-sm); font-weight: 600; color: var(--text); margin: 0;">
                  <%= member.fullName %>
                </p>
                <p style="font-size: var(--text-xs); color: var(--text-muted); margin: 0;"><%= member.email %></p>
              </div>
              <span class="badge badge-primary"><%= member.totalLoans %> checkouts</span>
            </div>
          <% }) %>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Quick Actions Panel -->
  <section aria-label="Management Navigation">
    <h2 style="font-size: var(--text-sm); font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-3);">
      Management Workspaces
    </h2>
    <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
      <a href="/admin/books" class="btn btn-secondary btn-sm">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span>Manage Books</span>
      </a>
      <a href="/admin/members" class="btn btn-secondary btn-sm">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
        </svg>
        <span>Manage Members</span>
      </a>
      <a href="/admin/loans" class="btn btn-secondary btn-sm">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        <span>Loan Ledgers</span>
      </a>
      <a href="/books" class="btn btn-secondary btn-sm">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
          <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
        </svg>
        <span>Public Catalogue</span>
      </a>
    </div>
  </section>
</div>

<!-- Chart.js CDN & Dashboard Script -->
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script>
<script src="/js/dashboard.js"></script>
