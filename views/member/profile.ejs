<%
  const profileUser = (typeof user !== 'undefined' && user) || (typeof currentUser !== 'undefined' && currentUser) || {};
  const initials = profileUser.fullName
    ? profileUser.fullName.split(' ').filter(Boolean).map(n => n[0]).join('').toUpperCase().slice(0, 2)
    : 'U';
%>
<div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16);">
  <!-- Breadcrumbs -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/dashboard">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span>Dashboard</span>
    </a>
    <span class="separator" aria-hidden="true">/</span>
    <span class="current" aria-current="page">Profile Settings</span>
  </nav>

  <!-- Header -->
  <div style="display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-8);">
    <h1 style="font-size: var(--text-3xl); font-weight: 800; letter-spacing: -0.03em;">Account & Profile Settings</h1>
    <p style="color: var(--text-muted); font-size: var(--text-base);">
      Manage your personal contact details, membership status, and circulation privileges.
    </p>
  </div>

  <div class="profile-grid">
    <!-- Left Column: Member Card & Quick Status -->
    <div>
      <div class="card" style="padding: var(--space-6); text-align: center;">
        <div class="profile-avatar-large">
          <% if (profileUser.profileImage) { %>
            <img src="<%= profileUser.profileImage %>" alt="<%= profileUser.fullName || 'User' %>" style="width: 100%; height: 100%; border-radius: var(--radius-full); object-fit: cover;">
          <% } else { %>
            <%= initials %>
          <% } %>
        </div>
        <h2 style="font-size: var(--text-xl); font-weight: 800; color: var(--text); margin-bottom: 4px;">
          <%= profileUser.fullName || 'Member' %>
        </h2>
        <p style="font-size: var(--text-sm); color: var(--text-muted); margin-bottom: var(--space-3);">
          <%= profileUser.email || '' %>
        </p>
        <div style="display: inline-flex; gap: 8px;">
          <span class="badge badge-primary">
            <span class="badge-dot"></span> <%= profileUser.role || 'MEMBER' %>
          </span>
          <span class="badge badge-success">
            <span class="badge-dot"></span> Active Status
          </span>
        </div>

        <!-- Membership Metrics -->
        <div style="margin-top: var(--space-6); padding-top: var(--space-6); border-top: 1px solid var(--border); display: flex; flex-direction: column; gap: var(--space-3); text-align: left; font-size: var(--text-sm);">
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Member Since</span>
            <strong style="color: var(--text);"><%= profileUser.createdAt ? (typeof h !== 'undefined' ? h.formatDate(profileUser.createdAt) : new Date(profileUser.createdAt).toLocaleDateString()) : 'N/A' %></strong>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Loan Quota</span>
            <strong style="color: var(--text);"><%= typeof config !== 'undefined' ? config.maxActiveLoans : 5 %> concurrent books</strong>
          </div>
          <div style="display: flex; justify-content: space-between;">
            <span style="color: var(--text-muted);">Loan Duration</span>
            <strong style="color: var(--text);"><%= typeof config !== 'undefined' ? config.loanDurationDays : 14 %> days / loan</strong>
          </div>
        </div>
      </div>

      <!-- Fines Summary Card (if any) -->
      <% if (fines && fines.totalFines > 0) { %>
        <div class="card" style="margin-top: var(--space-6); border-color: var(--danger-soft);">
          <div class="card-header" style="background-color: var(--danger-soft);">
            <h3 style="font-size: var(--text-sm); font-weight: 700; color: var(--danger); display: flex; align-items: center; gap: 6px;">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
              <span>Outstanding Fines</span>
            </h3>
            <span class="badge badge-danger">₹<%= fines.totalFines %> Total</span>
          </div>
          <div class="card-body" style="padding: var(--space-4);">
            <% fines.activeOverdue.forEach(loan => { %>
              <div style="display: flex; justify-content: space-between; align-items: center; padding: 6px 0; font-size: var(--text-xs); border-bottom: 1px dashed var(--border);">
                <div>
                  <p style="font-weight: 600; color: var(--text); margin: 0;"><%= loan.book ? loan.book.title : 'Book' %></p>
                  <span style="color: var(--danger);"><%= loan.daysOverdue %> days overdue</span>
                </div>
                <strong style="color: var(--danger); font-size: var(--text-sm);">₹<%= loan.calculatedFine %></strong>
              </div>
            <% }) %>
            <p style="font-size: var(--text-xs); color: var(--text-muted); margin-top: var(--space-3);">
              Fines can be settled or waived at the physical circulation desk during book return.
            </p>
          </div>
        </div>
      <% } %>
    </div>

    <!-- Right Column: Personal Information Form -->
    <div>
      <div class="card">
        <div class="card-header">
          <h2 style="font-size: var(--text-lg); font-weight: 700; color: var(--text);">Personal Information</h2>
        </div>
        <div class="card-body">
          <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
            <div class="toast toast-error" style="position: static; width: 100%; margin-bottom: var(--space-6); animation: none;" role="alert">
              <div class="toast-content">
                <ul style="list-style: none; margin: 0; padding: 0;">
                  <% errors.forEach(err => { %>
                    <li style="font-size: var(--text-xs);"><%= err.msg %></li>
                  <% }) %>
                </ul>
              </div>
            </div>
          <% } %>

          <form action="/profile" method="POST" data-loading data-validate id="profile-edit-form">
            <!-- Full Name -->
            <div class="form-group">
              <label class="form-label" for="fullName">
                <span>Full Name</span>
                <span class="required">*</span>
              </label>
              <div class="input-wrapper">
                <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                <input
                  type="text"
                  id="fullName"
                  name="fullName"
                  class="form-control has-icon-left"
                  value="<%= profileUser.fullName || '' %>"
                  required
                  minlength="2"
                >
              </div>
            </div>

            <!-- Email (Disabled) -->
            <div class="form-group">
              <label class="form-label" for="email">Email Address</label>
              <div class="input-wrapper">
                <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                <input
                  type="email"
                  id="email"
                  class="form-control has-icon-left"
                  value="<%= profileUser.email || '' %>"
                  disabled
                  style="background-color: var(--surface-2); cursor: not-allowed; opacity: 0.8;"
                >
              </div>
              <span class="form-hint">Email address serves as your unique membership identifier and cannot be changed.</span>
            </div>

            <!-- Phone Number -->
            <div class="form-group">
              <label class="form-label" for="phone">Phone Number</label>
              <div class="input-wrapper">
                <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                </svg>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="form-control has-icon-left"
                  value="<%= profileUser.phone || '' %>"
                  placeholder="+91 98765 43210"
                >
              </div>
            </div>

            <!-- Profile Image URL -->
            <div class="form-group">
              <label class="form-label" for="profileImage">Profile Image URL</label>
              <div class="input-wrapper">
                <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                <input
                  type="url"
                  id="profileImage"
                  name="profileImage"
                  class="form-control has-icon-left"
                  value="<%= profileUser.profileImage || '' %>"
                  placeholder="https://example.com/avatar.jpg"
                >
              </div>
              <span class="form-hint">Optional URL to your avatar picture. Initials avatar will be used by default.</span>
            </div>

            <div style="margin-top: var(--space-6); display: flex; justify-content: flex-end;">
              <button type="submit" class="btn btn-primary btn-md" id="profile-save-btn">
                <span>Save Profile Changes</span>
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</div>
