<div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16);">
  <!-- Welcome Banner -->
  <section class="dashboard-banner" aria-label="Member Welcome">
    <div>
      <div style="display: inline-flex; align-items: center; gap: 6px; padding: 4px 12px; background: rgba(255, 255, 255, 0.18); border-radius: var(--radius-full); font-size: var(--text-xs); font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-2);">
        <span>Member Portal</span>
      </div>
      <h1 class="dashboard-banner-title"><%= greeting %>, <%= (currentUser && currentUser.fullName) ? currentUser.fullName.split(' ')[0] : 'Member' %>!</h1>
      <p class="dashboard-banner-subtitle">
        Welcome to your library dashboard. Track your active loans, monitor due dates, and explore curated recommendations.
      </p>
    </div>
    <div>
      <a href="/books" class="btn btn-secondary btn-md" style="color: var(--primary); font-weight: 700;">
        <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
        <span>Borrow Books</span>
      </a>
    </div>
  </section>

  <!-- KPI Stats Grid -->
  <section class="stats-grid" aria-label="Member Statistics">
    <!-- Stat 1: Active Loans -->
    <div class="stat-card">
      <div class="stat-icon primary" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Active Loans</p>
        <p class="stat-value"><%= stats.activeLoans %><span style="font-size: var(--text-sm); font-weight: 500; color: var(--text-muted);"> / <%= typeof config !== 'undefined' ? config.maxActiveLoans : 5 %></span></p>
      </div>
    </div>

    <!-- Stat 2: Pending Requests -->
    <div class="stat-card">
      <div class="stat-icon warning" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Pending Requests</p>
        <p class="stat-value" style="<%= (stats.pendingRequests || 0) > 0 ? 'color: var(--warning);' : '' %>"><%= stats.pendingRequests || 0 %></p>
      </div>
    </div>

    <!-- Stat 3: Overdue Count -->
    <div class="stat-card">
      <div class="stat-icon danger" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Overdue Titles</p>
        <p class="stat-value" style="<%= stats.overdueCount > 0 ? 'color: var(--danger);' : '' %>"><%= stats.overdueCount %></p>
      </div>
    </div>

    <!-- Stat 4: Outstanding Fines -->
    <div class="stat-card">
      <div class="stat-icon warning" aria-hidden="true">
        <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </div>
      <div>
        <p class="text-xs text-muted" style="text-transform: uppercase; font-weight: 600; letter-spacing: 0.05em;">Outstanding Fine</p>
        <p class="stat-value" style="<%= stats.outstandingFine > 0 ? 'color: var(--warning);' : '' %>">
          <%= typeof h !== 'undefined' ? h.formatCurrency(stats.outstandingFine) : '₹' + stats.outstandingFine %>
        </p>
      </div>
    </div>
  </section>

  <!-- Currently Borrowed with Due-Date Progress Bars -->
  <section style="margin-bottom: var(--space-12);" aria-label="Currently Borrowed Books">
    <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4);">
      <div>
        <h2 style="font-size: var(--text-xl); font-weight: 800; letter-spacing: -0.02em;">Currently Borrowed</h2>
        <p style="font-size: var(--text-xs); color: var(--text-muted);">Books officially issued to you by the librarian</p>
      </div>
      <a href="/loans" class="btn btn-ghost btn-sm">
        <span>View My Borrowed Books</span>
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>

    <% if (activeLoans.length === 0) { %>
      <div class="empty-state" style="margin: 0; max-width: 100%;">
        <div class="empty-state-icon" aria-hidden="true">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        </div>
        <h3 class="empty-state-title">No books currently borrowed</h3>
        <p class="empty-state-desc">You don't have any books checked out right now. Browse our library catalogue to submit a borrow request.</p>
        <a href="/books" class="btn btn-primary btn-md">Browse Catalogue</a>
      </div>
    <% } else { %>
      <div style="display: flex; flex-direction: column; gap: var(--space-4);">
        <% activeLoans.forEach(loan => { %>
          <%
            const isOverdue = loan.status === 'OVERDUE';
            const totalDurationDays = typeof config !== 'undefined' ? config.loanDurationDays : 14;
            const diffMs = new Date(loan.dueDate) - new Date();
            const daysLeft = Math.ceil(diffMs / (1000 * 60 * 60 * 24));
            const percentElapsed = Math.min(100, Math.max(0, Math.round(((totalDurationDays - daysLeft) / totalDurationDays) * 100)));
            const fillClass = isOverdue ? 'danger' : (daysLeft <= 3 ? 'warning' : 'safe');
          %>
          <div class="loan-card" id="loan-card-<%= loan._id %>">
            <div class="loan-card-cover">
              <img
                src="<%= (loan.book && loan.book.coverImage) || (typeof h !== 'undefined' ? h.getPlaceholderCover(loan.book ? loan.book.title : 'Book') : '') %>"
                alt="Book cover"
                loading="lazy"
              >
            </div>

            <div class="loan-card-content">
              <h3 class="loan-card-title"><%= loan.book ? loan.book.title : 'Unknown Book' %></h3>
              <p class="loan-card-author">by <%= loan.book ? loan.book.author : 'Author' %></p>

              <!-- Due Date Progress Indicator -->
              <div class="due-progress-wrapper">
                <div class="due-progress-track">
                  <div class="due-progress-fill <%= fillClass %>" style="width: <%= isOverdue ? 100 : percentElapsed %>%;"></div>
                </div>
                <div style="display: flex; justify-content: space-between; font-size: var(--text-xs); color: var(--text-muted);">
                  <span>Issued: <%= typeof h !== 'undefined' ? h.formatDate(loan.issuedAt) : new Date(loan.issuedAt).toLocaleDateString() %></span>
                  <span>
                    <% if (isOverdue) { %>
                      <strong style="color: var(--danger);">Overdue by <%= loan.daysOverdue || Math.abs(daysLeft) %> days (Fine: ₹<%= loan.calculatedFine || 0 %>)</strong>
                    <% } else if (daysLeft === 0) { %>
                      <strong style="color: var(--warning);">Due today!</strong>
                    <% } else { %>
                      <span><%= daysLeft %> days remaining (Due <%= typeof h !== 'undefined' ? h.formatDate(loan.dueDate) : new Date(loan.dueDate).toLocaleDateString() %>)</span>
                    <% } %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Read-Only Status & Physical Return Guidance -->
            <div style="display: flex; flex-direction: column; align-items: flex-end; gap: var(--space-2); flex-shrink: 0;">
              <span class="badge <%= isOverdue ? 'badge-danger' : 'badge-primary' %>">
                <span class="badge-dot"></span> <%= loan.status %>
              </span>
              <span style="font-size: var(--text-xs); color: var(--text-muted); text-align: right; max-width: 140px; line-height: 1.3;">
                Return physical copy to librarian
              </span>
            </div>
          </div>
        <% }) %>
      </div>
    <% } %>
  </section>

  <!-- Popular Reads Recommendation Row -->
  <% if (popularBooks && popularBooks.length > 0) { %>
    <section style="margin-bottom: var(--space-12);" aria-label="Popular Books">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: var(--space-4);">
        <div>
          <h2 style="font-size: var(--text-xl); font-weight: 800; letter-spacing: -0.02em;">Recommended for You</h2>
          <p style="font-size: var(--text-xs); color: var(--text-muted);">Frequently borrowed across the community</p>
        </div>
        <a href="/books" class="btn btn-ghost btn-sm">Explore All →</a>
      </div>

      <div class="grid-4">
        <% popularBooks.forEach(book => { %>
          <%- include('../partials/book-card', { book }) %>
        <% }) %>
      </div>
    </section>
  <% } %>

  <!-- Quick Shortcuts -->
  <section aria-label="Quick Actions">
    <h2 style="font-size: var(--text-base); font-weight: 700; color: var(--text-muted); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: var(--space-3);">
      Quick Access
    </h2>
    <div style="display: flex; gap: var(--space-3); flex-wrap: wrap;">
      <a href="/books" class="btn btn-secondary btn-sm">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
        </svg>
        <span>Catalogue</span>
      </a>
      <a href="/loans" class="btn btn-secondary btn-sm">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span>My Active Loans</span>
      </a>
      <a href="/history" class="btn btn-secondary btn-sm">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        <span>Borrowing History</span>
      </a>
      <a href="/profile" class="btn btn-secondary btn-sm">
        <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
        </svg>
        <span>Profile Settings</span>
      </a>
    </div>
  </section>
</div>
