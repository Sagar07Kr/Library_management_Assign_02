<div class="auth-split-container">
  <!-- Left Side: Brand Gradient, Digital Illustration & Quote -->
  <div class="auth-brand-side">
    <div class="auth-brand-bg-pattern" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-pattern)" />
      </svg>
    </div>

    <!-- Top Badge & Header -->
    <div class="auth-brand-content">
      <div class="auth-brand-badge">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
        <span>Digital Library Intelligence</span>
      </div>
      <h2 class="auth-brand-title">Your Gateway to Knowledge & Discovery.</h2>
      <p class="auth-brand-desc">
        Access thousands of curated books, reserve titles with instant status checks, track loan deadlines, and stay ahead without hassle.
      </p>
    </div>

    <!-- Middle Hero Illustration (Vector SVG) -->
    <div class="auth-illustration-wrap" aria-hidden="true">
      <svg class="auth-illustration-svg" viewBox="0 0 420 300" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Floating Library Card Platform -->
        <rect x="40" y="60" width="340" height="200" rx="20" fill="rgba(255, 255, 255, 0.12)" stroke="rgba(255, 255, 255, 0.3)" stroke-width="2" />
        
        <!-- Shelf / Stacks -->
        <rect x="70" y="90" width="280" height="8" rx="4" fill="rgba(255, 255, 255, 0.4)" />
        <rect x="70" y="170" width="280" height="8" rx="4" fill="rgba(255, 255, 255, 0.4)" />
        
        <!-- Books on shelf 1 -->
        <rect x="80" y="40" width="24" height="50" rx="3" fill="#67E8F9" />
        <rect x="110" y="32" width="28" height="58" rx="3" fill="#A5B4FC" />
        <rect x="144" y="44" width="20" height="46" rx="3" fill="#FDE047" />
        <rect x="170" y="36" width="30" height="54" rx="3" fill="#F472B6" />
        <rect x="206" y="42" width="24" height="48" rx="3" fill="#34D399" />
        <rect x="236" y="30" width="26" height="60" rx="3" fill="#60A5FA" />
        <rect x="268" y="38" width="32" height="52" rx="3" fill="#C084FC" />
        
        <!-- Books on shelf 2 -->
        <rect x="85" y="120" width="30" height="50" rx="3" fill="#F87171" />
        <rect x="122" y="112" width="24" height="58" rx="3" fill="#FBBF24" />
        <rect x="152" y="124" width="32" height="46" rx="3" fill="#38BDF8" />
        <rect x="190" y="116" width="22" height="54" rx="3" fill="#818CF8" />
        <rect x="218" y="122" width="28" height="48" rx="3" fill="#4ADE80" />
        <rect x="252" y="114" width="26" height="56" rx="3" fill="#E879F9" />

        <!-- Floating Stat Pill -->
        <g filter="drop-shadow(0 10px 15px rgba(0, 0, 0, 0.15))">
          <rect x="110" y="195" width="200" height="46" rx="23" fill="#FFFFFF" />
          <circle cx="134" cy="218" r="14" fill="#4F46E5" />
          <path d="M129 218 L133 222 L140 214" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <text x="156" y="215" fill="#0F172A" font-size="12" font-weight="700" font-family="sans-serif">Book Issued</text>
          <text x="156" y="229" fill="#64748B" font-size="10" font-family="sans-serif">Due in 14 days</text>
        </g>
      </svg>
    </div>

    <!-- Bottom Quote -->
    <div class="auth-brand-quote">
      <p>"A room without books is like a body without a soul."</p>
      <span>— Marcus Tullius Cicero</span>
    </div>
  </div>

  <!-- Right Side: Clean SaaS Login Form -->
  <div class="auth-form-side">
    <div class="auth-form-card">
      <div class="auth-header">
        <div class="auth-header-icon" aria-hidden="true">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1" />
          </svg>
        </div>
        <h1 class="auth-title">Welcome Back</h1>
        <p class="auth-subtitle">Sign in to your LibraryMS account to manage books & loans</p>
      </div>

      <!-- Server Validation Errors Alert -->
      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="toast toast-error" style="position: static; width: 100%; margin-bottom: var(--space-6); animation: none;" role="alert">
          <div class="toast-icon-wrap" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="toast-content">
            <ul style="list-style: none; margin: 0; padding: 0;">
              <% errors.forEach(err => { %>
                <li class="toast-message" style="font-size: var(--text-xs);"><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        </div>
      <% } %>

      <!-- Login Form -->
      <form action="/login" method="POST" data-loading id="login-form">
        <!-- Email Input with Inner SVG Icon -->
        <div class="form-group">
          <label class="form-label" for="email">
            <span>Email Address</span>
            <span class="required">*</span>
          </label>
          <div class="input-wrapper">
            <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <input
              type="email"
              id="email"
              name="email"
              class="form-control has-icon-left"
              placeholder="you@domain.com"
              value="<%= typeof values !== 'undefined' ? values.email || '' : '' %>"
              required
              autocomplete="email"
            >
          </div>
        </div>

        <!-- Password Input with Inner SVG Icon & Show/Hide Toggle -->
        <div class="form-group">
          <label class="form-label" for="password">
            <span>Password</span>
            <span class="required">*</span>
          </label>
          <div class="input-wrapper">
            <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
            </svg>
            <input
              type="password"
              id="password"
              name="password"
              class="form-control has-icon-left has-icon-right"
              placeholder="Enter your password"
              required
              autocomplete="current-password"
            >
            <button
              type="button"
              class="input-icon-right"
              data-password-toggle="password"
              aria-label="Toggle password visibility"
            >
              <!-- Eye open icon -->
              <svg class="icon-eye" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
              </svg>
              <!-- Eye off icon -->
              <svg class="icon-eye-off" width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display: none;">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
              </svg>
            </button>
          </div>
        </div>

        <!-- Options: Remember Me & Forgot Password -->
        <div class="auth-options-row">
          <label class="checkbox-label" for="remember">
            <input type="checkbox" id="remember" name="remember">
            <span>Remember me for 30 days</span>
          </label>
          <a href="/forgot-password" class="forgot-password-link">Forgot password?</a>
        </div>

        <!-- Submit Button with Spinner -->
        <button type="submit" class="btn btn-primary btn-block btn-lg" id="login-submit-btn">
          <span>Sign In to Account</span>
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>

      <!-- Footer: Link to Register -->
      <div class="auth-footer">
        <p>Don't have an account yet? <a href="/register">Create an account</a></p>
      </div>
    </div>
  </div>
</div>
