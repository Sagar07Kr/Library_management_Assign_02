<div class="auth-split-container">
  <!-- Left Side: Brand Gradient, Digital Illustration & Quote -->
  <div class="auth-brand-side">
    <div class="auth-brand-bg-pattern" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="grid-pattern-fp" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#grid-pattern-fp)" />
      </svg>
    </div>

    <!-- Top Badge & Header -->
    <div class="auth-brand-content">
      <div class="auth-brand-badge">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
        </svg>
        <span>Account Security</span>
      </div>
      <h2 class="auth-brand-title">Recover Your Library Account.</h2>
      <p class="auth-brand-desc">
        Enter your registered email address to receive password reset instructions and securely regain access to your borrowing dashboard.
      </p>
    </div>

    <!-- Middle Hero Illustration -->
    <div class="auth-illustration-wrap" aria-hidden="true">
      <svg class="auth-illustration-svg" viewBox="0 0 420 300" fill="none" xmlns="http://www.w3.org/2000/svg">
        <rect x="40" y="60" width="340" height="200" rx="20" fill="rgba(255, 255, 255, 0.12)" stroke="rgba(255, 255, 255, 0.3)" stroke-width="2" />
        <circle cx="210" cy="140" r="45" fill="rgba(255, 255, 255, 0.2)" />
        <path d="M210 115v25m0 0v25m-20-25h40" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" />
        <g filter="drop-shadow(0 10px 15px rgba(0, 0, 0, 0.15))">
          <rect x="110" y="195" width="200" height="46" rx="23" fill="#FFFFFF" />
          <circle cx="134" cy="218" r="14" fill="#10B981" />
          <path d="M129 218 L133 222 L140 214" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          <text x="156" y="215" fill="#0F172A" font-size="12" font-weight="700" font-family="sans-serif">Secure Recovery</text>
          <text x="156" y="229" fill="#64748B" font-size="10" font-family="sans-serif">One-click verification</text>
        </g>
      </svg>
    </div>

    <!-- Bottom Quote -->
    <div class="auth-brand-quote">
      <p>"Security is not an afterthought, but the foundation of trust."</p>
      <span>— LibraryMS Security Protocols</span>
    </div>
  </div>

  <!-- Right Side: Forgot Password Form Card -->
  <div class="auth-form-side">
    <div class="auth-form-card">
      <div class="auth-header">
        <div class="auth-header-icon" aria-hidden="true" style="color: var(--primary);">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 7a2 2 0 012 2m4 0a6 6 0 01-7.743 5.743L11 17H9v2H7v2H4a1 1 0 01-1-1v-2.586a1 1 0 01.293-.707l5.964-5.964A6 6 0 1121 9z" />
          </svg>
        </div>
        <h1 class="auth-title">Forgot Password?</h1>
        <p class="auth-subtitle">No worries! Enter your email address and we'll help you reset your password.</p>
      </div>

      <!-- Server Validation Errors Alert -->
      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="toast toast-error" style="position: static; width: 100%; margin-bottom: var(--space-6); animation: none;" role="alert">
          <div class="toast-icon-wrap" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="toast-content">
            <ul style="list-style: none; margin: 0; padding: 0;">
              <% errors.forEach(err => { %>
                <li class="toast-message" style="font-size: var(--text-xs);"><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        </div>
      <% } %>

      <!-- Form -->
      <form action="/forgot-password" method="POST" data-loading id="forgot-password-form">
        <div class="form-group">
          <label class="form-label" for="email">
            <span>Registered Email Address</span>
            <span class="required">*</span>
          </label>
          <div class="input-wrapper">
            <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <input
              type="email"
              id="email"
              name="email"
              class="form-control has-icon-left"
              placeholder="name@example.com"
              value="<%= typeof values !== 'undefined' ? values.email || '' : '' %>"
              required
              autocomplete="email"
              autofocus
            >
          </div>
        </div>

        <button type="submit" class="btn btn-primary btn-block btn-lg" id="forgot-submit-btn">
          <span>Continue to Reset Password</span>
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>

      <!-- Footer: Back to Login -->
      <div class="auth-footer" style="margin-top: var(--space-6); text-align: center;">
        <p>Remember your credentials? <a href="/login">Return to Sign In</a></p>
      </div>
    </div>
  </div>
</div>
