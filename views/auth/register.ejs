<div class="auth-split-container">
  <!-- Left Side: Brand Gradient Panel, Illustration & Quote -->
  <div class="auth-brand-side">
    <div class="auth-brand-bg-pattern" aria-hidden="true">
      <svg width="100%" height="100%" xmlns="http://www.w3.org/2000/svg">
        <defs>
          <pattern id="reg-grid-pattern" width="40" height="40" patternUnits="userSpaceOnUse">
            <path d="M 40 0 L 0 0 0 40" fill="none" stroke="currentColor" stroke-width="1" />
          </pattern>
        </defs>
        <rect width="100%" height="100%" fill="url(#reg-grid-pattern)" />
      </svg>
    </div>

    <!-- Top Badge & Header -->
    <div class="auth-brand-content">
      <div class="auth-brand-badge">
        <svg width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
        </svg>
        <span>Instant Library Access</span>
      </div>
      <h2 class="auth-brand-title">Join a Vibrant Community of Lifelong Readers.</h2>
      <p class="auth-brand-desc">
        Create your membership in seconds. Borrow up to 5 books concurrently, explore curated recommendations, and track lending history seamlessly.
      </p>
    </div>

    <!-- Vector Digital Library Illustration -->
    <div class="auth-illustration-wrap" aria-hidden="true">
      <svg class="auth-illustration-svg" viewBox="0 0 420 280" fill="none" xmlns="http://www.w3.org/2000/svg">
        <!-- Floating Digital Member Pass -->
        <rect x="50" y="40" width="320" height="200" rx="20" fill="rgba(255, 255, 255, 0.14)" stroke="rgba(255, 255, 255, 0.35)" stroke-width="2" />
        
        <!-- Member Card Elements -->
        <circle cx="100" cy="95" r="28" fill="rgba(255, 255, 255, 0.25)" />
        <path d="M100 82 C106 82 110 86 110 92 C110 98 106 102 100 102 C94 102 90 98 90 92 C90 86 94 82 100 82 Z" fill="#FFFFFF" />
        <path d="M82 115 C82 106 90 104 100 104 C110 104 118 106 118 115" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" fill="none" />
        
        <rect x="144" y="80" width="160" height="14" rx="4" fill="#FFFFFF" />
        <rect x="144" y="102" width="100" height="10" rx="4" fill="rgba(255, 255, 255, 0.6)" />
        
        <!-- Perks pill -->
        <rect x="75" y="150" width="270" height="60" rx="12" fill="rgba(0, 0, 0, 0.15)" />
        <circle cx="105" cy="180" r="14" fill="#10B981" />
        <path d="M100 180 L103 183 L110 176" stroke="#FFFFFF" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
        <text x="130" y="176" fill="#FFFFFF" font-size="12" font-weight="700" font-family="sans-serif">Full Member Privileges</text>
        <text x="130" y="192" fill="rgba(255, 255, 255, 0.75)" font-size="10" font-family="sans-serif">Borrowing • History • Analytics</text>
      </svg>
    </div>

    <!-- Bottom Quote -->
    <div class="auth-brand-quote">
      <p>"The only thing that you absolutely have to know, is the location of the library."</p>
      <span>— Albert Einstein</span>
    </div>
  </div>

  <!-- Right Side: Registration Form -->
  <div class="auth-form-side">
    <div class="auth-form-card" style="max-width: 480px;">
      <div class="auth-header">
        <div class="auth-header-icon" aria-hidden="true">
          <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M18 9v3m0 0v3m0-3h3m-3 0h-3m-2-5a4 4 0 11-8 0 4 4 0 018 0zM3 20a6 6 0 0112 0v1H3v-1z" />
          </svg>
        </div>
        <h1 class="auth-title">Create Account</h1>
        <p class="auth-subtitle">Join LibraryMS to discover, borrow, and track your reads</p>
      </div>

      <!-- Server Validation Errors Alert -->
      <% if (typeof errors !== 'undefined' && errors.length > 0) { %>
        <div class="toast toast-error" style="position: static; width: 100%; margin-bottom: var(--space-6); animation: none;" role="alert">
          <div class="toast-icon-wrap" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
            </svg>
          </div>
          <div class="toast-content">
            <ul style="list-style: none; margin: 0; padding: 0;">
              <% errors.forEach(err => { %>
                <li class="toast-message" style="font-size: var(--text-xs);"><%= err.msg %></li>
              <% }) %>
            </ul>
          </div>
        </div>
      <% } %>

      <form action="/register" method="POST" data-loading data-validate id="register-form">
        <!-- Full Name Field -->
        <div class="form-group">
          <label class="form-label" for="fullName">
            <span>Full Name</span>
            <span class="required">*</span>
          </label>
          <div class="input-wrapper">
            <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            <input
              type="text"
              id="fullName"
              name="fullName"
              class="form-control has-icon-left"
              placeholder="e.g. John Doe"
              value="<%= typeof values !== 'undefined' ? values.fullName || '' : '' %>"
              required
              minlength="2"
              autocomplete="name"
            >
          </div>
        </div>

        <!-- Email Field -->
        <div class="form-group">
          <label class="form-label" for="email">
            <span>Email Address</span>
            <span class="required">*</span>
          </label>
          <div class="input-wrapper">
            <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
            </svg>
            <input
              type="email"
              id="email"
              name="email"
              class="form-control has-icon-left"
              placeholder="you@domain.com"
              value="<%= typeof values !== 'undefined' ? values.email || '' : '' %>"
              required
              autocomplete="email"
            >
          </div>
        </div>

        <!-- Side-by-side Password and Confirm Password -->
        <div class="form-row">
          <!-- Password Field with Show/Hide -->
          <div class="form-group">
            <label class="form-label" for="reg-password">
              <span>Password</span>
              <span class="required">*</span>
            </label>
            <div class="input-wrapper">
              <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
              <input
                type="password"
                id="reg-password"
                name="password"
                class="form-control has-icon-left has-icon-right"
                placeholder="Min. 6 chars"
                required
                minlength="6"
                autocomplete="new-password"
              >
              <button
                type="button"
                class="input-icon-right"
                data-password-toggle="reg-password"
                aria-label="Toggle password visibility"
              >
                <svg class="icon-eye" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg class="icon-eye-off" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display: none;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>
          </div>

          <!-- Confirm Password Field with Show/Hide -->
          <div class="form-group">
            <label class="form-label" for="reg-confirm">
              <span>Confirm</span>
              <span class="required">*</span>
            </label>
            <div class="input-wrapper">
              <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
              <input
                type="password"
                id="reg-confirm"
                name="confirmPassword"
                class="form-control has-icon-left has-icon-right"
                placeholder="Repeat password"
                required
                autocomplete="new-password"
              >
              <button
                type="button"
                class="input-icon-right"
                data-password-toggle="reg-confirm"
                aria-label="Toggle password visibility"
              >
                <svg class="icon-eye" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
                </svg>
                <svg class="icon-eye-off" width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" style="display: none;">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M13.875 18.825A10.05 10.05 0 0112 19c-4.478 0-8.268-2.943-9.543-7a9.97 9.97 0 011.563-3.029m5.858.908a3 3 0 114.243 4.243M9.878 9.878l4.242 4.242M9.88 9.88l-3.29-3.29m7.532 7.532l3.29 3.29M3 3l18 18" />
                </svg>
              </button>
            </div>
          </div>
        </div>

        <!-- Dynamic Password Strength Meter -->
        <div class="password-strength-container" aria-live="polite">
          <div class="password-strength-bars">
            <div class="strength-bar" id="strength-bar-1"></div>
            <div class="strength-bar" id="strength-bar-2"></div>
            <div class="strength-bar" id="strength-bar-3"></div>
            <div class="strength-bar" id="strength-bar-4"></div>
          </div>
          <div class="strength-text">
            <span>Password Strength</span>
            <span id="strength-label" style="font-weight: 600;"></span>
          </div>
        </div>

        <!-- Phone Field -->
        <div class="form-group">
          <label class="form-label" for="phone">
            <span>Phone Number</span>
            <span class="text-muted text-xs">(optional)</span>
          </label>
          <div class="input-wrapper">
            <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
            </svg>
            <input
              type="tel"
              id="phone"
              name="phone"
              class="form-control has-icon-left"
              placeholder="+91 98765 43210"
              value="<%= typeof values !== 'undefined' ? values.phone || '' : '' %>"
              autocomplete="tel"
            >
          </div>
        </div>

        <!-- Terms Agreement -->
        <div class="form-group" style="margin-top: var(--space-4); margin-bottom: var(--space-6);">
          <label class="checkbox-label" for="terms">
            <input type="checkbox" id="terms" required checked>
            <span>I agree to library terms, borrowing rules, and 14-day loan policies</span>
          </label>
        </div>

        <!-- Submit Button -->
        <button type="submit" class="btn btn-primary btn-block btn-lg" id="register-submit-btn">
          <span>Complete Registration</span>
          <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </button>
      </form>

      <!-- Footer: Link to Login -->
      <div class="auth-footer">
        <p>Already have an account? <a href="/login">Sign in</a></p>
      </div>
    </div>
  </div>
</div>
