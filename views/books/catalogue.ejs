<div class="container" style="padding-top: var(--space-8); padding-bottom: var(--space-16);">
  <!-- Breadcrumbs Navigation -->
  <nav class="breadcrumbs" aria-label="Breadcrumb">
    <a href="/">
      <svg width="16" height="16" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
      </svg>
      <span>Home</span>
    </a>
    <span class="separator" aria-hidden="true">/</span>
    <span class="current" aria-current="page">Book Catalogue</span>
  </nav>

  <!-- Page Header -->
  <div style="display: flex; flex-direction: column; gap: var(--space-2); margin-bottom: var(--space-6);">
    <h1 style="font-size: var(--text-3xl); font-weight: 800; letter-spacing: -0.03em;">Library Catalogue</h1>
    <p style="color: var(--text-muted); font-size: var(--text-base);">
      Browse, search, and discover from our curated collection of <%= pagination.total %> title<%= pagination.total !== 1 ? 's' : '' %>.
    </p>
  </div>

  <!-- Catalogue Layout (Sidebar Filters + Main Grid) -->
  <div class="catalogue-layout">
    <!-- Filter Sidebar Form -->
    <aside class="catalogue-sidebar" aria-label="Search and Filter Books">
      <form action="/books" method="GET" id="catalogue-filter-form">
        <div class="catalogue-sidebar-header">
          <h2 class="catalogue-sidebar-title">
            <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 4a1 1 0 011-1h16a1 1 0 011 1v2.586a1 1 0 01-.293.707l-6.414 6.414a1 1 0 00-.293.707V17l-4 4v-6.586a1 1 0 00-.293-.707L3.293 7.293A1 1 0 013 6.586V4z" />
            </svg>
            <span>Filters</span>
          </h2>
          <a href="/books" class="btn btn-ghost btn-sm" style="padding: 2px 6px; font-size: var(--text-xs);" id="filter-reset-link">Reset</a>
        </div>

        <!-- Search by Keyword -->
        <div class="form-group">
          <label class="form-label" for="filter-search">Keyword Search</label>
          <div class="input-wrapper">
            <svg class="input-icon-left" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="search"
              id="filter-search"
              name="search"
              class="form-control has-icon-left"
              placeholder="Title or author..."
              value="<%= filters.search || '' %>"
            >
          </div>
        </div>

        <!-- Category Dropdown -->
        <div class="form-group">
          <label class="form-label" for="filter-category">Category</label>
          <select name="category" id="filter-category" class="form-control">
            <option value="all">All Categories</option>
            <% categories.forEach(cat => { %>
              <option value="<%= cat %>" <%= filters.category === cat ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
        </div>

        <!-- Availability Filter -->
        <div class="form-group">
          <label class="form-label" for="filter-availability">Availability</label>
          <select name="availability" id="filter-availability" class="form-control">
            <option value="">All Copies</option>
            <option value="available" <%= filters.availability === 'available' ? 'selected' : '' %>>Available Now</option>
            <option value="unavailable" <%= filters.availability === 'unavailable' ? 'selected' : '' %>>Currently Out of Stock</option>
          </select>
        </div>

        <!-- Hidden Sort Input (to preserve sort selection during filter submit) -->
        <input type="hidden" name="sort" id="sidebar-sort-input" value="<%= filters.sort || 'newest' %>">

        <button type="submit" class="btn btn-primary btn-block btn-md" style="margin-top: var(--space-4);" id="filter-submit-btn">
          <span>Apply Filters</span>
        </button>
      </form>
    </aside>

    <!-- Main Results Column -->
    <section aria-label="Book list">
      <!-- Toolbar: View Switcher & Sort Selector -->
      <div class="catalogue-toolbar">
        <div style="font-size: var(--text-sm); color: var(--text-muted);">
          Showing <strong style="color: var(--text);"><%= books.length %></strong> of <%= pagination.total %> titles
        </div>

        <div style="display: flex; align-items: center; gap: var(--space-3);">
          <!-- Sort Dropdown -->
          <div style="display: flex; align-items: center; gap: var(--space-2);">
            <label for="catalogue-sort-select" class="text-xs text-muted" style="font-weight: 600;">SORT BY</label>
            <select
              id="catalogue-sort-select"
              class="form-control"
              style="height: 36px; padding-top: 0; padding-bottom: 0; font-size: var(--text-xs);"
              onchange="document.getElementById('sidebar-sort-input').value = this.value; document.getElementById('catalogue-filter-form').submit();"
            >
              <option value="newest" <%= filters.sort === 'newest' ? 'selected' : '' %>>Newest First</option>
              <option value="oldest" <%= filters.sort === 'oldest' ? 'selected' : '' %>>Oldest First</option>
              <option value="title_asc" <%= filters.sort === 'title_asc' ? 'selected' : '' %>>Title (A–Z)</option>
              <option value="title_desc" <%= filters.sort === 'title_desc' ? 'selected' : '' %>>Title (Z–A)</option>
              <option value="author_asc" <%= filters.sort === 'author_asc' ? 'selected' : '' %>>Author (A–Z)</option>
              <option value="availability" <%= filters.sort === 'availability' ? 'selected' : '' %>>Most Copies Available</option>
            </select>
          </div>

          <!-- Grid / List View Toggle Buttons -->
          <div class="view-toggle-group" role="group" aria-label="View mode">
            <button type="button" class="view-toggle-btn active" id="view-grid-btn" aria-label="Grid view">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z" />
              </svg>
            </button>
            <button type="button" class="view-toggle-btn" id="view-list-btn" aria-label="List view">
              <svg width="18" height="18" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
              </svg>
            </button>
          </div>
        </div>
      </div>

      <!-- Book Cards Grid/List Container -->
      <% if (books.length === 0) { %>
        <div class="empty-state">
          <div class="empty-state-icon" aria-hidden="true">
            <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
            </svg>
          </div>
          <h3 class="empty-state-title">No books found</h3>
          <p class="empty-state-desc">
            We couldn't find any books matching your search or active filters. Try broadening your criteria or reset the filters.
          </p>
          <a href="/books" class="btn btn-secondary btn-md">Reset All Filters</a>
        </div>
      <% } else { %>
        <div class="grid-3 books-container" id="books-container">
          <% books.forEach(book => { %>
            <%- include('../partials/book-card', { book }) %>
          <% }) %>
        </div>

        <!-- Accessible Pagination -->
        <% if (pagination.totalPages > 1) { %>
          <%
            const paginationData = {
              page: pagination.page,
              pages: pagination.totalPages,
              hasPrev: pagination.page > 1,
              hasNext: pagination.page < pagination.totalPages,
            };
            const queryData = {
              search: filters.search || '',
              category: filters.category || '',
              availability: filters.availability || '',
              sort: filters.sort || '',
            };
          %>
          <%- include('../partials/pagination', { pagination: paginationData, query: queryData }) %>
        <% } %>
      <% } %>
    </section>
  </div>
</div>
